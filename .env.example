# ─────────────────────────────────────────────────────────────
#  FaceSearch — Environment Variables
#  Copy to .env and fill in values before running
#  NEVER commit .env to git
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=facesearch
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── MinIO (S3-compatible object storage) ─────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRY=7d

# ── API Gateway ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Face Service ─────────────────────────────────────────────
# buffalo_l  = best accuracy  (~500 MB download)
# buffalo_sc = smaller/faster (~200 MB download)
MODEL_NAME=buffalo_l
LOG_LEVEL=info

# ── Worker ───────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=worker-group
KAFKA_TOPIC=image.uploaded
FACE_SERVICE_URL=http://localhost:8000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Use the same values as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=images
MINIO_SECURE=false
WORKER_CONCURRENCY=4

# ── Web Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
