{
  "name": "@facesearch/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for the FaceSearch monorepo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "private": true
}
